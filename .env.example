# URL Oficial da Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nome da Aplicação
NEXT_PUBLIC_APP_NAME="Acelera Auto CRM"

# URL do Projeto SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave Pública (Publishable Key / Anon Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# Chave Privada Administrativa (Secret Key / Service Role Key)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# URL da API do Asaas (Sandbox / Produção)
ASAAS_API_URL=https://sandbox.asaas.com/api/v3

# Chave de API do Asaas
ASAAS_API_KEY=$aact_hmlg_your_asaas_api_key_here

# Token Secreto para Validação do Webhook do Asaas (header asaas-access-token)
ASAAS_WEBHOOK_SECRET=token_secreto_para_validar_webhook_acelera
